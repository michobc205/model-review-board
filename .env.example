# Copy this file to `.env` for local development. `.env` is ignored by Git.
# Never put real secrets or copied database URLs in this file.

# Local default: a SQLite file in the `instance` folder. No cloud account needed.
# On Render, this value comes from the managed database, not from this file.
DATABASE_URL=sqlite:///review_board.db

# Any long random text. Use a different value in every environment.
SECRET_KEY=change-me-to-a-long-random-text
